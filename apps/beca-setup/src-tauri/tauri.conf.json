{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BECA",
  "version": "0.1.7",
  "identifier": "com.fattyrecording.beca.setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BECA",
        "width": 980,
        "height": 820,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "binaries/*",
      "WebView2Loader.dll",
      "resources/**/*",
      "../../../docs/user/READ_BEFORE_FIRST_LAUNCH.md"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerHooks": "./windows/hooks.nsh",
        "minimumWebview2Version": "110.0.1531.0"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "postInstallScript": "linux/deb/postinst"
      }
    }
  }
}
